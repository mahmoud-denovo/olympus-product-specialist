FROM python:3.14-rc-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/src

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml /app/
RUN pip install --no-cache-dir fastapi uvicorn pydantic requests rich pydantic-settings

COPY src /app/src
COPY agents-cli-manifest.yaml /app/

EXPOSE 8000

CMD ["uvicorn", "olympus_specialist.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
